<Window x:Class="MMH.OrientationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C0101418"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Round "petal" button. Each petal's DOWN label is rotated so its
             bottom faces away from the centre; only one will read upright. -->
        <Style x:Key="PetalButton" TargetType="Button">
            <Setter Property="Width" Value="138"/>
            <Setter Property="Height" Value="138"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Petal" Fill="#2F8F9D" Stroke="#7FD3DC" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Petal" Property="Fill" Value="#3FB4C3"/>
                                <Setter TargetName="Petal" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Petal" Property="Fill" Value="#257682"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="360" Height="360">
            <!-- Tag = clockwise quarter-turns applied to the label -->
            <Button Style="{StaticResource PetalButton}" Tag="0" Click="Petal_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <TextBlock Text="DOWN"/>
            </Button>
            <Button Style="{StaticResource PetalButton}" Tag="1" Click="Petal_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="DOWN" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource PetalButton}" Tag="2" Click="Petal_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="DOWN" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform Angle="180"/></TextBlock.RenderTransform>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource PetalButton}" Tag="3" Click="Petal_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="DOWN" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform Angle="270"/></TextBlock.RenderTransform>
                </TextBlock>
            </Button>

            <!-- Centre of the clover shows which monitor this is -->
            <Ellipse Width="74" Height="74" Fill="#1C2A30" Stroke="#7FD3DC" StrokeThickness="2"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="MonitorNumberText" Text="1" Foreground="White" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="Click the DOWN that reads the right way up"
                   Foreground="White" FontSize="18" Margin="0,24,0,0" HorizontalAlignment="Center"/>
        <TextBlock Text="Press Esc to skip"
                   Foreground="#99FFFFFF" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>

<Window x:Class="MMH.OrientationConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C0101418"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#1C2A30" BorderBrush="#7FD3DC" BorderThickness="2" CornerRadius="16"
            Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Keep this orientation?" Foreground="White" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CountdownText" Text="Reverting in 15 seconds" Foreground="#CCFFFFFF" FontSize="15"
                       Margin="0,8,0,20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Keep" Width="120" Height="40" FontSize="16" Margin="0,0,12,0"
                        IsDefault="True" Click="Keep_Click"/>
                <Button Content="Revert" Width="120" Height="40" FontSize="16"
                        IsCancel="True" Click="Revert_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

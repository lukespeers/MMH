<Window x:Class="MMH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MMH"
        mc:Ignorable="d"
        Title="MMH" Width="380" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="#12191C" FontFamily="Segoe UI" Foreground="#E6F4F6"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Same palette as the orientation / Identify overlays -->
        <SolidColorBrush x:Key="CardBrush" Color="#1C2A30"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#22363D"/>
        <SolidColorBrush x:Key="PetalBrush" Color="#2F8F9D"/>
        <SolidColorBrush x:Key="PetalHoverBrush" Color="#3FB4C3"/>
        <SolidColorBrush x:Key="PetalStrokeBrush" Color="#7FD3DC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FB3B9"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A3D44"/>

        <!-- Small round toolbar button with a Segoe icon glyph -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#E6F4F6"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PetalBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PetalStrokeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#257682"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The clickable top row of a profile card -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6F4F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="Click to apply this profile"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="10,9">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263F47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The round numbered "petal" on each card; lights up while the card is hovered -->
        <Style x:Key="PetalEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Fill" Value="{StaticResource PetalBrush}"/>
            <Setter Property="Stroke" Value="{StaticResource PetalStrokeBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource PetalHoverBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PetalNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActivePill" TargetType="Border">
            <Setter Property="Background" Value="#1F4A51"/>
            <Setter Property="BorderBrush" Value="{StaticResource PetalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Display checkboxes / primary radios drawn as small round chips -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#E6F4F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="14" Background="#12191C"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PetalStrokeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PetalBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PetalStrokeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Chip}"/>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Chip}"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12191C"/>
            <Setter Property="Foreground" Value="#E6F4F6"/>
            <Setter Property="CaretBrush" Value="#E6F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6F4F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12,4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PetalBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="EditorPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="14,0,14,12"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,12,14,10">
        <!-- Header: title + tool icons -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MMH" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Multi Monitor Helper" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE7F4;" ToolTip="Identify Monitors" Click="IdentifyMonitors_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Check Orientation" Click="CheckOrientation_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Restore All Displays (turn every display on)" Click="RestoreAll_Click"/>
                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit profiles" Click="EditToggle_Click"/>
            </StackPanel>
        </Grid>

        <!-- Profile 1 -->
        <Border x:Name="Profile1_Card" Style="{StaticResource Card}">
            <StackPanel>
                <Button Style="{StaticResource CardButton}" Click="ApplyProfile1_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Ellipse Style="{StaticResource PetalEllipse}"/>
                            <TextBlock Style="{StaticResource PetalNumber}" Text="1"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Profile1_Title" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="Profile1_Mini" Orientation="Horizontal" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="Profile1_Active" Grid.Column="2" Style="{StaticResource ActivePill}">
                            <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource PetalStrokeBrush}"/>
                        </Border>
                    </Grid>
                </Button>
                <StackPanel x:Name="Profile1_Editor" Style="{StaticResource EditorPanel}">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Displays on"/>
                        <WrapPanel x:Name="Profile1_DisplaysPanel"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Primary"/>
                        <WrapPanel x:Name="Profile1_PrimaryPanel"/>
                    </StackPanel>
                    <TextBox x:Name="Profile1_Description" ToolTip="Name / description"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Profile 2 -->
        <Border x:Name="Profile2_Card" Style="{StaticResource Card}">
            <StackPanel>
                <Button Style="{StaticResource CardButton}" Click="ApplyProfile2_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Ellipse Style="{StaticResource PetalEllipse}"/>
                            <TextBlock Style="{StaticResource PetalNumber}" Text="2"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Profile2_Title" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="Profile2_Mini" Orientation="Horizontal" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="Profile2_Active" Grid.Column="2" Style="{StaticResource ActivePill}">
                            <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource PetalStrokeBrush}"/>
                        </Border>
                    </Grid>
                </Button>
                <StackPanel x:Name="Profile2_Editor" Style="{StaticResource EditorPanel}">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Displays on"/>
                        <WrapPanel x:Name="Profile2_DisplaysPanel"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Primary"/>
                        <WrapPanel x:Name="Profile2_PrimaryPanel"/>
                    </StackPanel>
                    <TextBox x:Name="Profile2_Description" ToolTip="Name / description"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Profile 3 -->
        <Border x:Name="Profile3_Card" Style="{StaticResource Card}">
            <StackPanel>
                <Button Style="{StaticResource CardButton}" Click="ApplyProfile3_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Ellipse Style="{StaticResource PetalEllipse}"/>
                            <TextBlock Style="{StaticResource PetalNumber}" Text="3"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Profile3_Title" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="Profile3_Mini" Orientation="Horizontal" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="Profile3_Active" Grid.Column="2" Style="{StaticResource ActivePill}">
                            <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource PetalStrokeBrush}"/>
                        </Border>
                    </Grid>
                </Button>
                <StackPanel x:Name="Profile3_Editor" Style="{StaticResource EditorPanel}">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Displays on"/>
                        <WrapPanel x:Name="Profile3_DisplaysPanel"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource EditorLabel}" Text="Primary"/>
                        <WrapPanel x:Name="Profile3_PrimaryPanel"/>
                    </StackPanel>
                    <TextBox x:Name="Profile3_Description" ToolTip="Name / description"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Edit mode only: how many display slots each profile has -->
        <StackPanel x:Name="EditFooter" Orientation="Horizontal" Margin="2,0,0,6" Visibility="Collapsed">
            <TextBlock Text="Display slots" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="DisplayCountTextBox" Width="34" Text="3" HorizontalContentAlignment="Center" Margin="0,0,8,0"/>
            <Button Style="{StaticResource TextButton}" Content="Regenerate" FontSize="11" Click="Regenerate_Click"/>
        </StackPanel>

        <TextBlock x:Name="HintText" Text="Click a profile to apply it" FontSize="11"
                   Foreground="#6F9298" HorizontalAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>
</Window>
